{
  "name": "tack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "bun run evals/run.ts",
    "eval:typecheck": "tsc -p evals/tsconfig.json",
    "eval:kibana:up": "docker compose -f evals/kibana/compose.yml up -d",
    "eval:kibana:down": "docker compose -f evals/kibana/compose.yml down -v",
    "eval:kibana:seed": "bun run evals/kibana/seed-logs.ts",
    "eval:kibana:config": "bun run evals/kibana/write-tack-config.ts",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^26.1.1",
    "turbo": "2.10.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
