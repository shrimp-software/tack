{
  "name": "tack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "bun run evals/run.ts",
    "eval:typecheck": "tsc -p evals/tsconfig.json",
    "eval:kibana:up": "docker compose -f evals/kibana/compose.yml up -d",
    "eval:kibana:down": "docker compose -f evals/kibana/compose.yml down -v",
    "eval:kibana:seed": "bun run evals/kibana/seed-logs.ts",
    "eval:kibana:config": "bun run evals/kibana/write-tack-config.ts",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^26.1.1",
    "turbo": "2.10.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrimp-software/tack.git"
  },
  "homepage": "https://github.com/shrimp-software/tack#readme",
  "bugs": {
    "url": "https://github.com/shrimp-software/tack/issues"
  },
  "description": "Tack turns live sources — MCP servers, local TypeScript modules, and plugin bundles — into agent-friendly TypeScript tools. It discovers tools, infers stable operation paths, generates a typed SDK, and exposes `execute` and `guide` over MCP.",
  "main": "index.js",
  "dependencies": {
    "acorn": "^8.18.0",
    "argparse": "^2.0.1",
    "assertion-error": "^2.0.1",
    "bun-types": "^1.3.14",
    "chai": "^6.2.2",
    "commander": "^15.0.0",
    "convert-source-map": "^2.0.0",
    "cross-spawn": "^7.0.6",
    "detect-libc": "^2.1.2",
    "es-module-lexer": "^2.3.1",
    "esbuild": "^0.28.1",
    "estree-walker": "^3.0.3",
    "eventsource": "^3.0.7",
    "eventsource-parser": "^3.1.0",
    "execa": "^10.0.0",
    "expect-type": "^1.4.0",
    "fdir": "^6.5.0",
    "figures": "^6.1.0",
    "get-stream": "^9.0.1",
    "human-signals": "^8.0.1",
    "is-extglob": "^2.1.1",
    "is-glob": "^4.0.3",
    "is-plain-obj": "^4.1.0",
    "is-stream": "^4.0.1",
    "is-unicode-supported": "^2.1.0",
    "isexe": "^2.0.0",
    "jose": "^6.2.4",
    "js-yaml": "^4.3.0",
    "json-schema-to-typescript": "^15.0.4",
    "lightningcss": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-linux-x64-musl": "^1.33.0",
    "lodash": "^4.18.1",
    "magic-string": "^0.30.21",
    "minimist": "^1.2.8",
    "nanoid": "^3.3.16",
    "npm-run-path": "^6.0.0",
    "obug": "^2.1.4",
    "parse-ms": "^4.0.0",
    "path-key": "^4.0.0",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "pkce-challenge": "^5.0.1",
