{
  "name": "@cbxss/tack-typecheck",
  "version": "2.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cbxss/tack-codemode": "2.0.0",
    "@cbxss/tack-core": "2.0.0",
    "@cbxss/tack-sdk-types": "2.0.0",
    "typescript-5": "npm:typescript@^5.9.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrimp-software/tack.git"
  },
  "homepage": "https://github.com/shrimp-software/tack#readme",
  "bugs": {
    "url": "https://github.com/shrimp-software/tack/issues"
  }
}
