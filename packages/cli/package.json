{
  "name": "@cbxss/tack",
  "version": "2.2.0",
  "type": "module",
  "bin": {
    "tack": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/make-bin-executable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@cbxss/tack-agent": "2.2.0",
    "@cbxss/tack-codemode": "2.2.0",
    "@cbxss/tack-core": "2.2.0",
    "@cbxss/tack-generator": "2.2.0",
    "@cbxss/tack-plugin": "2.2.0",
    "@cbxss/tack-runtime-quickjs": "2.2.0",
    "@cbxss/tack-runtime-workerd": "2.2.0",
    "@cbxss/tack-service": "2.2.0",
    "@cbxss/tack-sources": "2.2.0",
    "@cbxss/tack-typecheck": "2.2.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "execa": "^10.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrimp-software/tack.git"
  },
  "homepage": "https://github.com/shrimp-software/tack#readme",
  "bugs": {
    "url": "https://github.com/shrimp-software/tack/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
